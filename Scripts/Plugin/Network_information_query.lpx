#!name=网络信息查询 𝕏
#!desc=网络信息请求、网络变化、查询脚本，带独立开关
#!author=xream
#!icon=location.circle.system

[Argument]
request_enable = switch, true, tag=网络信息请求, desc=启用/禁用网络信息请求脚本
event_enable = switch, true, tag=网络信息变化, desc=启用/禁用网络信息变化脚本
query_enable = switch, true, tag=网络信息查询, desc=启用/禁用网络信息查询脚本

[Rule]
DOMAIN-SUFFIX,speedtest.cn,DIRECT
DOMAIN-SUFFIX,ip.im,DIRECT
DOMAIN-SUFFIX,ip.plus,DIRECT

[Script]
http-request ^https?:\/\/net-lsp-x\.com script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/network-info/net-lsp-x.js, requires-body=false, timeout=120, tag=网络信息请求 𝕏, enable={request_enable}
network-changed script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/network-info/net-lsp-x.js, timeout=120, tag=网络信息变化 𝕏, argument="TYPE=EVENT&icon=globe.asia.australia&icon-color=#6699FF&LAN=0&SSID=0&IPv6=0&MASK=0&DOMESTIC_IPv4=spcn&DOMESTIC_IPv6=ddnspod&LANDING_IPv4=ipapi&LANDING_IPv6=ipsb&PRIVACY=0&FLAG=1&ENTRANCE_DELAY=0&EVENT_DELAY=3", enable={event_enable}
generic script-path=https://raw.githubusercontent.com/xream/scripts/main/surge/modules/network-info/net-lsp-x.js, timeout=120, tag=网络信息查询 𝕏, img-url=location.circle.system, enable={query_enable}

[MITM]
hostname = %APPEND% net-lsp-x.com